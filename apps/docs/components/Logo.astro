---
import { withBase } from "blume/components/islands/base-path.ts";

// humation-app のヘッダーと合わせて、アイコン + ワードマーク画像の構成にする
// (テキストのブランド名は使わない)。ワードマークは黒固定の線画なので、
// ダークだけ白版に差し替える (humation-app 側は未対応だが、docs はダークがあるので必要)。
// GitHub マークは navigation.repo が header 側で描くので、ここでは扱わない。
interface Props {
  site: { title: string };
  logo?: {
    svg?: string;
    light?: string;
    dark?: string;
    alt?: string;
    href?: string;
    text?: string;
  } | null;
}

const { logo } = Astro.props;

const icon = logo?.light;
const brandHref = logo?.href ?? "/";
---

<a
  class="inline-flex min-w-0 items-center gap-3 font-semibold text-base text-foreground"
  href={withBase(brandHref)}
>
  {
    icon && (
      <img
        alt={logo?.alt ?? ""}
        class="h-5 w-auto shrink-0"
        height="20"
        src={withBase(icon)}
        width="20"
      />
    )
  }
  <img
    alt="Humation"
    class="h-4 w-auto shrink-0 dark:hidden"
    height="16"
    src={withBase("/logo_humation.svg")}
    width="102"
  />
  <img
    alt="Humation"
    class="hidden h-4 w-auto shrink-0 dark:block"
    height="16"
    src={withBase("/logo_humation_dk.svg")}
    width="102"
  />
</a>
